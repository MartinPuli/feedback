{
  "manifest_version": 3,
  "name": "FeedbackLoop Collector",
  "version": "0.1.0",
  "description": "Recopila feedback real de cualquier web sin tocar su código.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
